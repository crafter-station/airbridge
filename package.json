{
  "name": "airbridge",
  "version": "1.0.0",
  "description": "Share folders between Windows and macOS over your LAN",
  "private": true,
  "license": "MIT",
  "author": "Ignacio Rueda",
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crafter-station/airbridge.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "loopback": "node scripts/loopback.mjs",
    "demo": "node scripts/demo.mjs",
    "package": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && electron-vite build && electron-builder",
    "package:dir": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && electron-vite build && electron-builder --dir",
    "test": "node scripts/smoke.mjs && node scripts/loopback.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "bonjour-service": "^1.4.4",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3"
  }
}
